apiVersion: pubsub.cnrm.cloud.google.com/v1beta1
kind: PubSubSubscription
metadata:
  name: serviceperformance
  annotations:
    cnrm.cloud.google.com/project-id: "{{GOOGLE_PROJECT}}"
spec:
  bigqueryConfig:
    writeMetadata: True
    tableRef:
      name: serviceperformance
  topicRef:
    name: serviceperformance
---
apiVersion: bigquery.cnrm.cloud.google.com/v1beta1
kind: BigQueryDataset
metadata:
  name: serviceperformance
  annotations:
    cnrm.cloud.google.com/project-id: "{{GOOGLE_PROJECT}}"
spec:
  resourceID: serviceperformance
  location: europe-west2
---
apiVersion: bigquery.cnrm.cloud.google.com/v1beta1
kind: BigQueryTable
metadata:
  name: serviceperformance
  annotations:
    cnrm.cloud.google.com/project-id: "{{GOOGLE_PROJECT}}"
spec:
  resourceID: serviceperformance
  friendlyName: serviceperformance
  datasetRef:
    name: serviceperformance
  schema: >
    [
      {"name": "data","type": "JSON","mode": "NULLABLE","description": "The data"},
      {"name": "subscription_name","type": "string","mode": "NULLABLE","description": "service name"},
      {"name": "attributes","type": "string","mode": "NULLABLE","description": "name of the vm"},
      {"name": "publish_time","type": "TIMESTAMP","mode": "NULLABLE","description": "time published"},
      {"name": "message_id","type": "string","mode": "NULLABLE","description": "name of nic reporting"}
    ]
---
apiVersion: pubsub.cnrm.cloud.google.com/v1beta1
kind: PubSubTopic
metadata:
  name: serviceperformance
  annotations:
    cnrm.cloud.google.com/project-id: "{{GOOGLE_PROJECT}}"
