---
apiVersion: compute.cnrm.cloud.google.com/v1beta1
kind: ComputeNetwork
metadata:
  name: london
  labels:
    customer: acme
spec:
  routingMode: REGIONAL
  autoCreateSubnetworks: false
---
apiVersion: compute.cnrm.cloud.google.com/v1beta1
kind: ComputeSubnetwork
metadata:
  name: london-internal
  labels:
    customer: acme
spec:
  ipCidrRange: 10.0.50.0/24
  region: "{{GOOGLE_REGION}}"
  description: london Network
  networkRef:
    name: london
---
apiVersion: compute.cnrm.cloud.google.com/v1beta1
kind: ComputeRouter
metadata:
  name: london-router
  labels:
    customer: acme
spec:
  description: london router
  region: "{{GOOGLE_REGION}}"
  networkRef:
    name: london
---
apiVersion: compute.cnrm.cloud.google.com/v1beta1
kind: ComputeRouterNAT
metadata:
  name: 'london-nat'
  labels:
    customer: acme
spec:
  region: "{{GOOGLE_REGION}}"
  routerRef:
    name: london-router
  natIpAllocateOption: AUTO_ONLY
  sourceSubnetworkIpRangesToNat: ALL_SUBNETWORKS_ALL_IP_RANGES
---
apiVersion: compute.cnrm.cloud.google.com/v1beta1
kind: ComputeFirewall
metadata:
  name: london-allowed
  labels:
    customer: acme
spec:
  allow:
    - protocol: tcp
      ports:
       - "0-65535"
    - protocol: udp
      ports:
       - "0-65535"
    - protocol: icmp
  networkRef:
    name: london
  direction: INGRESS
  sourceRanges:
    - 0.0.0.0/0
---
apiVersion: compute.cnrm.cloud.google.com/v1beta1
kind: ComputeInstance
metadata:
  annotations:
    cnrm.cloud.google.com/allow-stopping-for-update: "true"
  name: london-app1
  labels:
    customer: acme
spec:
  machineType: e2-small
  zone: {{GOOGLE_ZONE}}
  bootDisk:
    initializeParams:
      size: 50
      type: pd-ssd
      sourceImageRef:
        external: ubuntu-os-cloud/ubuntu-2204-lts
  networkInterface:
    - subnetworkRef:
        name: london-internal
      accessConfig:
        - natIpRef:
            name: london-app1-ip
    - subnetworkRef:
        external: "https://www.googleapis.com/compute/v1/projects/{{GOOGLE_PROJECT}}/regions/{{GOOGLE_REGION}}/subnetworks/mgmt-subnet"
  canIpForward: true
  metadataStartupScript: "sudo apt-get update; sudo apt-get install -yq python3"
  metadata:
    - key: ssh-keys
      value: {{GOOGLE_USER}}:{{GOOGLE_SSH_KEY}}
---
apiVersion: compute.cnrm.cloud.google.com/v1beta1
kind: ComputeAddress
metadata:
  name: london-app1-ip
  labels:
    customer: acme
spec:
  addressType: EXTERNAL
  description: external address
  location: "{{GOOGLE_REGION}}"
