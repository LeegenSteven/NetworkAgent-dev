# <== Enter custom agent configurations in this file.
# See https://cloud.google.com/stackdriver/docs/solutions/agents/ops-agent/configuration
# for more details.
logging:
  receivers:
    vyos_syslog:
      type: syslog
      transport_protocol: udp
      listen_host: 0.0.0.0
      listen_port: 5140
  processors:
    add_vyos_marker:
      type: modify_fields
      fields:
        jsonPayload.source:
          static_value: "vyos"
  service:
    pipelines:
      vyos_pipeline:
        receivers: [vyos_syslog]
        processors: [add_vyos_marker]
